<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle Name="Charts Preview" Manufacturer="org.huxerui.lib.charts.preview" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
          UpgradeCode="@HUXERUI_WINDOWS_BUNDLE_UPGRADE_CODE@">
    <BootstrapperApplication SourceFile="!(bindpath.Installer)\example_charts-Installer.exe">
      <PayloadGroupRef Id="HuxerUIInstallerResources" />
      <Payload SourceFile="!(bindpath.Installer)\mbanative.dll" />
    </BootstrapperApplication>
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Charts Preview" />
    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="0" />
    <Chain>
      <MsiPackage SourceFile="!(bindpath.Package)\example_charts.msi">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
        <MsiProperty Name="CREATE_DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
